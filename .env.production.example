# NodeBI production configuration. Copy to .env beside nodebi.exe and replace every placeholder.
NODE_ENV=production
PORT=3001
DATA_DIR=
ALLOWED_ORIGIN=https://nodebi.example.com
PUBLIC_URL=https://nodebi.example.com

# Generate independent secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
SHARE_SECRET=replace-with-32-byte-random

# Used only to create the first administrator when the user database is empty.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-on-first-start

# Optional legacy static admin token. Leave blank for new installations.
AUTH_TOKEN=

# Safety and development switches.
ENABLE_SEED=false
MAX_RESPONSE_ROWS=10000
CLIENT_DIST=

# Optional CAS-style authentication proxy. Password login remains available at /login.
# NODEBI_PROXYAUTH_NAME=ticket
# NODEBI_PROXYAUTH_URL=https://sso.example.com/validate
# NODEBI_PROXYAUTH_LOGIN_URL=https://sso.example.com/login
# Capture group 1 must contain the NodeBI login.
# NODEBI_PROXYAUTH_REGEX=<cas:user>([^<]+)</cas:user>
